# Non-secret Cloud Run runtime configuration. Copy to cloudrun.env.yaml and adjust.
# RAG_ENABLED and RAG_EMBEDDING_* are set by deploy-cloud-run.ps1 based on its -EmbeddingProvider
# / -DisableRag parameters, not here; do not add them below or the deploy will emit a duplicate key.
# If DEMO_LIMITS_TRUSTED_PROXY_HOPS is missing below, the script adds it from -TrustedProxyHops
# (default 1).
APP_INTERFACE: http
OLLAMA_ENABLED: "false"
DEMO_LIMITS_ENABLED: "true"
DEMO_LIMITS_FIRESTORE_ENABLED: "true"
DEMO_LIMITS_DAILY_REQUESTS: "1000"
DEMO_LIMITS_HOURLY_REQUESTS_PER_IP: "20"
DEMO_LIMITS_CONCURRENT_STREAMS: "10"
DEMO_LIMITS_MAX_INPUT_CHARACTERS: "20000"
DEMO_LIMITS_MAX_HISTORY_MESSAGES: "10"
DEMO_LIMITS_MAX_OUTPUT_TOKENS_PER_CALL: "1500"
# 1 for Cloud Run alone, 2 behind an external Application Load Balancer. The default 0 ignores
# X-Forwarded-For and puts every client into one shared limit.
DEMO_LIMITS_TRUSTED_PROXY_HOPS: "1"
FIRESTORE_DATABASE_ID: "(default)"
# Optional agent mode with the private ai-agent-lab service: its URL is the service_url output of
# that project's Terraform. The service account created by deploy-cloud-run.ps1 needs
# roles/run.invoker on it (the agent project grants it).
# AGENT_LAB_ENABLED: "true"
# AGENT_LAB_BASE_URL: "https://ai-agent-lab-xxxxxxxxxx-ew.a.run.app"
# AGENT_LAB_AUTHENTICATION: "GOOGLE_ID_TOKEN"
