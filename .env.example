# Copy this file to .env and adjust the local container configuration if needed.
AI_DEMO_IMAGE=ghcr.io/martinbelas/ai-demo:latest
AI_DEMO_PORT=8080
OLLAMA_MODEL=qwen3:4b

# API keys are needed only when the corresponding cloud provider is selected.
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional agent mode (README, "Agent Mode"): answers through a running ai-agent-lab service.
AGENT_LAB_ENABLED=false
# Empty uses the default: http://localhost:8081 when the application runs directly,
# http://host.docker.internal:8081 inside Docker Compose (the lab running on the host).
AGENT_LAB_BASE_URL=
# Empty uses the default of 70 s; keep it longer than the lab's AGENT_TIMEOUT_SECONDS.
AGENT_LAB_TIMEOUT_SECONDS=
# Empty uses NONE (local lab). GOOGLE_ID_TOKEN authenticates to a private Cloud Run lab.
AGENT_LAB_AUTHENTICATION=
