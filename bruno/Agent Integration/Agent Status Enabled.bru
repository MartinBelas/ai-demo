meta {
  name: Agent Status Enabled
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/agent/status
  body: none
  auth: none
}

script:pre-request {
  if (bru.getEnvName() !== "LocalAgent") {
    bru.runner.skipRequest();
  }
}

tests {
  test("agent mode is enabled", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.eql({ enabled: true });
  });
}
