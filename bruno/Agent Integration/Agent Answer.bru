meta {
  name: Agent Answer
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/chat
  body: json
  auth: none
}

body:json {
  {
    "agent": true,
    "messages": [
      {
        "role": "USER",
        "content": "What is 7 times 6?"
      }
    ]
  }
}

script:pre-request {
  if (bru.getEnvName() !== "LocalAgent") {
    bru.runner.skipRequest();
  }
}

tests {
  test("answers through the agent service", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.model).to.equal("agent-lab");
    expect(body.answer).to.be.a("string").and.not.empty;
    expect(body).to.not.have.property("sources");
  });

  test("reports the token usage of all agent steps", function () {
    const usage = res.getBody().tokenUsage;
    expect(usage.promptTokens).to.be.above(0);
    expect(usage.completionTokens).to.be.above(0);
    expect(usage.totalTokens).to.equal(usage.promptTokens + usage.completionTokens);
  });

  test("returns web sources only as http(s) links", function () {
    (res.getBody().webSources || []).forEach(function (source) {
      expect(source).to.have.all.keys("title", "url");
      expect(source.url).to.match(/^https?:\/\//);
    });
  });
}
