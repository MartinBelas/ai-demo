meta {
  name: Agent Answer Needing Current Data
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/chat
  body: json
  auth: none
}

body:json {
  {
    "agent": true,
    "messages": [
      {
        "role": "USER",
        "content": "What is the current EUR to CZK exchange rate?"
      }
    ]
  }
}

docs {
  Usually makes the agent search the web (one Tavily credit). Whether it searches is the
  model's decision, so the checks hold either way; the found pages are in webSources.
}

script:pre-request {
  if (bru.getEnvName() !== "LocalAgent") {
    bru.runner.skipRequest();
  }
}

tests {
  test("answers through the agent service", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.model).to.equal("agent-lab");
    expect(body.answer).to.be.a("string").and.not.empty;
    expect(body).to.not.have.property("sources");
  });

  test("returns web sources only as http(s) links", function () {
    (res.getBody().webSources || []).forEach(function (source) {
      expect(source).to.have.all.keys("title", "url");
      expect(source.url).to.match(/^https?:\/\//);
    });
  });
}
