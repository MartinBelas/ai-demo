meta {
  name: Health
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/health
  body: none
  auth: none
}

tests {
  test("returns HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns application status", function () {
    expect(res.getHeader("content-type")).to.contain("application/json");
    expect(res.getBody()).to.eql({ status: "UP" });
  });
}
