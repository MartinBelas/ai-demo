meta {
  name: App Status
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/app/status
  body: none
  auth: none
}

tests {
  test("returns safe aggregate metrics", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().trackingEnabled).to.be.a("boolean");
    expect(res.getBody().period).to.match(/^\d{4}-\d{2}-\d{2}$/);
    expect(res.getBody().requests).to.be.at.least(0);
    expect(res.getBody()).to.not.have.property("clientHash");
  });
}
