meta {
  name: Reject Empty Conversation
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/chat
  body: json
  auth: none
}

body:json {
  {
    "provider": "OLLAMA",
    "messages": []
  }
}

tests {
  test("returns HTTP 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("returns the stable validation error", function () {
    expect(res.getBody()).to.eql({
      code: "INVALID_REQUEST",
      message: "Invalid chat request."
    });
  });
}
