tests {
  test("returns HTTP 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("returns the stable validation error", function () {
    expect(res.getBody()).to.eql({
      code: "INVALID_REQUEST",
      message: "Invalid chat request.",
      details: [
        {
          field: "messages",
          message: "The RAG question exceeds the configured size limit or is empty."
        }
      ]
    });
  });
}
